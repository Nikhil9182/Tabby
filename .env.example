# Tabby Supabase Configuration
# Required: Supabase Project URL and Public Client Key (Publishable Key / Anon Key)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback if using anon key:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEVER put Supabase secret key or service_role key in frontend code or .env.
# NEVER create VITE_SUPABASE_SERVICE_ROLE_KEY.

# Optional: Google Gemini Vision AI API Key for high-accuracy receipt scanning
# Free tier (1,500 scans/day, no credit card required) from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
