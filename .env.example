# Tabby Supabase Configuration
# Required: Supabase Project URL and Public Client Key (Publishable Key / Anon Key)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback if using anon key:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEVER put Supabase secret key or service_role key in frontend code or .env.
# NEVER create VITE_SUPABASE_SERVICE_ROLE_KEY.

# AI Receipt Scanning (Google Gemini Vision):
# NOTE: The Gemini API key is configured ONLY on the server side as a Supabase Edge Function secret.
# Never add VITE_GEMINI_API_KEY to frontend environment files or client bundles.
# Set on Supabase via CLI:
#   npx supabase secrets set GEMINI_API_KEY=your_gemini_api_key
#   npx supabase secrets set GEMINI_MODEL=gemini-2.5-flash
