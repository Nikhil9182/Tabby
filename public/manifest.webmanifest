{
  "name": "Tabby — Expense Splitter",
  "short_name": "Tabby",
  "description": "Split bills with friends and groups. Track who owes whom and settle up easily.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0055FF",
  "background_color": "#FAFAF9",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Expense",
      "short_name": "New Expense",
      "description": "Record a new expense split",
      "url": "./expenses/new",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settle Up",
      "short_name": "Settle",
      "description": "Record a payment",
      "url": "./settlements/new",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
